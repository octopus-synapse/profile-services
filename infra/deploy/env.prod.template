# Production `.env` template — rendered by .github/workflows/deploy.yml into
# /opt/profile-services/.env on the VPS.
#
# THIS FILE IS THE ANSWER TO "what does production need?". It is versioned and
# reviewable in a PR; the box is no longer the source of truth. Adding a var to
# the app means adding it here, or the deploy will not carry it.
#
# Two kinds of line:
#   - literal values (ports, hostnames, feature flags) live here in the open;
#   - shell-style placeholders are filled from GitHub Actions secrets at deploy
#     time. Every placeholder must resolve non-empty or the deploy aborts
#     BEFORE the container is swapped.
#
# IMAGE_TAG is deliberately absent: the workflow appends it after rendering,
# so a rollback can pin a tag without re-rendering the rest of the file.

NODE_ENV=production
BACKEND_PORT=8080

# Migrations run as an explicit workflow step before the container is
# recreated (see infra/deploy/migrate-and-seed.sh). Boot must not retry them.
RUN_MIGRATIONS_ON_BOOT=false

# --- Database ---
# `postgres` is the compose service name on the deploy network.
POSTGRES_USER="${POSTGRES_USER}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD}"
POSTGRES_DB="${POSTGRES_DB}"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="${REDIS_PASSWORD}"
# The no-op queue silently drops jobs; production must use the real one.
ENABLE_BULLMQ=true

# --- Auth ---
# JWT_ISSUER/JWT_AUDIENCE are required in production by EnvConfigSchema's
# superRefine: issuer pinning stops a refresh token minted on one deploy from
# being replayed against another, audience pinning stops cross-tier reuse.
JWT_SECRET="${JWT_SECRET}"
JWT_EXPIRATION=7d
JWT_ISSUER=patch-careers
JWT_AUDIENCE=patch-clients
IP_HASH_SALT="${IP_HASH_SALT}"
PERSISTENT_SESSION_EXPIRY_DAYS="30"
OAUTH_REDIRECT_URI_ALLOWLIST=""

# --- Mail (transactional via Resend SMTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS="${RESEND_API_KEY}"
EMAIL_FROM=noreply@patchcareers.org
EMAIL_FROM_NAME="Patch Careers"

# --- Public URLs ---
FRONTEND_URL=https://patchcareers.org
PUBLIC_APP_URL=https://patchcareers.org
CORS_ORIGIN="https://patchcareers.org"

# --- Object storage ---
MINIO_ENDPOINT="srv1073054.hstgr.cloud:9000"
MINIO_ACCESS_KEY="${MINIO_ACCESS_KEY}"
MINIO_SECRET_KEY="${MINIO_SECRET_KEY}"
MINIO_BUCKET="profile-uploads"

# --- Internal ---
INTERNAL_API_TOKEN="${INTERNAL_API_TOKEN}"

# --- Attestation witness ---
# The signing key is a PEM kept on ONE line with literal \n sequences (see
# .env.example) — docker compose env_file does not parse real newlines.
ATTESTATION_WITNESS_KEY_ID="witness-key-20260325-c4f278de"
ATTESTATION_WITNESS_SIGNING_PRIVATE_KEY="${ATTESTATION_WITNESS_SIGNING_PRIVATE_KEY}"

# --- Observability (Datadog / OpenTelemetry) ---
DD_API_KEY="${DD_API_KEY}"
DD_SITE=datadoghq.com
DD_ENV=prod
DD_SERVICE=profile-services
DD_OBSERVABILITY_ENABLED=true
DD_PRODUCT_EVENTS_ENABLED=true
DD_OTEL_ENABLED=true
DD_AGENT_HOST=datadog-agent
DD_DOGSTATSD_HOST=datadog-agent
DD_DOGSTATSD_PORT=8125
DD_TRACE_AGENT_PORT=8126
DD_OTLP_TRACES_URL=http://datadog-agent:4318/v1/traces
