// Resume Model - Core resume entity

model Resume {
  id     String @id @default(dbgenerated("uuidv7()"))
  userId String
  user   User   @relation("UserResumes", fields: [userId], references: [id], onDelete: Cascade)

  title String?
  // ADR-003 §11: canonical locale tags from `@packages/i18n` (`pt-BR` / `en`).
  // Migration `20261206000000_normalize_resume_locale_vocabulary` rewrote the
  // legacy `pt-br` rows and moved the defaults. Normalize at the edges with
  // `parseLocale` — never compare against a raw spelling.
  language String  @default("pt-BR")
  isPublic Boolean @default(false)
  slug     String? @unique

  // ADR-003: `language` is the canonical (authored) locale; the other locale
  // is derived. Résumé-level prose in the other locale lives here, keyed by
  // locale — `{ [locale]: { summary, headline, jobTitle, sourceHash,
  // translatedAt, origin } }` — with `origin` telling whether the machine
  // wrote it ("derived") or the person did ("manual" / "diverged"). Per-item
  // prose is on `SectionItem.translations` with the same envelope.
  translations Json?

  // Tech Persona
  techPersona     String?
  techArea        String?
  primaryStack    String[]
  experienceYears Int?     @default(0)

  // Contact info — email is intentionally NOT stored here. The canonical
  // address lives on `User.email` and is read via the `user` relation.
  fullName String?
  jobTitle String?
  // One-line professional headline ("Frontend Engineer @ Vercel"). Moved from
  // `User.headline` (ADR-003 §7): it is prose, so it needs a locale, and the
  // résumé is where prose has one.
  headline String? @db.VarChar(120)
  phone    String?
  location String?
  linkedin String?

  // Desired role for the market-relative Readiness Score. Soft reference to
  // a `RoleTitle` (no hard FK — that taxonomy is re-imported), plus the label
  // snapshot which is what coverage actually matches against. Null → Readiness
  // falls back to skill-count coverage.
  targetRoleId    String?
  targetRoleLabel String?
  github   String?
  website  String?
  summary  String? @db.Text

  currentCompanyLogo String?

  // Social links
  twitter       String?
  medium        String?
  devto         String?
  stackoverflow String?
  kaggle        String?
  hackerrank    String?
  leetcode      String?

  // Visual customization
  accentColor String? @default("#3B82F6")
  customTheme Json?

  // Resume Style System — the single source of truth for visual style.
  // The legacy free-string `template` column (PROFESSIONAL/CREATIVE/...)
  // was removed: it had no writers, no readers, and only existed in the
  // Zod request schema. ResumeStyle covers ATS-safety + render pipeline
  // wiring via `typstTemplate`.
  styleId String?
  style   ResumeStyle? @relation("ResumeActiveStyle", fields: [styleId], references: [id], onDelete: SetNull)

  // Stats
  profileViews Int @default(0)
  totalStars   Int @default(0)
  totalCommits Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Relations
  users               User[]                      @relation("UserPrimaryResume")
  resumeSections      ResumeSection[]
  shares              ResumeShare[]               @relation("ResumeShares")
  versions            ResumeVersion[]             @relation("ResumeVersions")
  qualityScoreHistory ResumeQualityScoreHistory[]
  readinessScoreHistory ReadinessScoreHistory[]
  import              ResumeImport?
  collaborators       ResumeCollaborator[]        @relation("ResumeCollaborators")
  collabComments      CollaborationComment[]      @relation("ResumeComments")

  @@index([userId])
  // P2-#34: `slug` is already `@unique` which implicitly creates an
  // index; the redundant `@@index([slug])` was a write-amplification cost
  // with no read benefit.
  @@index([isPublic])
  @@index([createdAt])
  @@index([techPersona])
  @@index([styleId])
}
